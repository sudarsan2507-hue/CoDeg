# CoDeg backend configuration. Copy to `.env` (gitignored) and adjust.
# All variables are optional; defaults shown are the local-dev defaults.

# Backend HTTP/WebSocket port.
PORT=4000

# Comma-separated CORS allowlist for the Socket.IO server.
# Use "*" to disable the check (trusted/internal deployments only).
ALLOWED_ORIGIN=http://localhost:5173

# Trust the first X-Forwarded-For hop for per-IP rate limiting.
# Enable ONLY when running behind a reverse proxy you control — the header is
# client-spoofable when the backend is directly exposed.
TRUST_PROXY=false

# Run player code as a bare host subprocess when Docker is unavailable.
# NO sandboxing — solo local play only, never a server others can reach.
ALLOW_UNSANDBOXED_EXECUTION=false

# Override the Docker sandbox image (e.g. pin an exact digest in production).
CODEG_DOCKER_IMAGE=python:3.12.7-alpine3.20
